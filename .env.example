# Copy to .env and fill in - every node makes a real, structured-output call
# to Claude now (see tot_marl/llm.py and the prompts in tot_marl/nodes/*.py).
ANTHROPIC_API_KEY=your-key-here

# Flips nodes/critic.py from the prompted LLMRouter to a trained checkpoint.
# Leave false until a pi_phi checkpoint actually exists (blueprint Section 5).
TOT_MARL_USE_LEARNED_ROUTER=false
